{
  "name": "rocket-chat-mcp",
  "version": "0.1.0",
  "description": "MCP server for self-hosted Rocket.Chat — six tools (5 read, 1 write) over stdio. Works with Claude Code, Claude Desktop, and MCP Inspector.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rocket-chat-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rocket-chat",
    "rocketchat",
    "claude",
    "anthropic",
    "stdio"
  ],
  "author": "k1sina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1sina/rocket-chat-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/k1sina/rocket-chat-mcp/issues"
  },
  "homepage": "https://github.com/k1sina/rocket-chat-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
