# Required: full base URL of your Rocket.Chat instance.
# No trailing slash. Do NOT include /api/v1 — the client appends it.
ROCKETCHAT_URL=https://chat.example.com

# Required: from My Account → Personal Access Tokens in Rocket.Chat.
# After creating a token, the UI shows both values below.
# Be sure to enable "Ignore Two Factor Authentication" when creating the token,
# otherwise API calls will fail with totp-required.
ROCKETCHAT_USER_ID=
ROCKETCHAT_AUTH_TOKEN=

# Optional: set to "1" to log API call metadata (method, path, status,
# duration) to stderr. No bodies are logged.
# DEBUG=1
